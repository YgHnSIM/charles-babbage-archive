---
interface Props {
  videoId: string;
  title: string;
  subtitle?: string;
  badge?: string;
  theme?: 'emerald' | 'purple' | 'rose' | 'brass' | 'blue';
  aspectRatio?: string;
  description?: string;
}

const {
  videoId,
  title,
  subtitle,
  badge = '사료 영상 해제',
  theme = 'brass',
  description
} = Astro.props;

const themeBorderStyles = {
  emerald: 'border-emerald-500/30 hover:border-emerald-500/50 bg-emerald-950/20 text-emerald-400',
  purple: 'border-purple-500/30 hover:border-purple-500/50 bg-purple-950/20 text-purple-400',
  rose: 'border-rose-500/30 hover:border-rose-500/50 bg-rose-950/20 text-rose-400',
  brass: 'border-brass-500/30 hover:border-brass-500/50 bg-brass-950/20 text-brass-400',
  blue: 'border-blue-500/30 hover:border-blue-500/50 bg-blue-950/20 text-blue-400'
};

const badgeStyles = {
  emerald: 'border-emerald-500/40 bg-emerald-950/50 text-emerald-300',
  purple: 'border-purple-500/40 bg-purple-950/50 text-purple-300',
  rose: 'border-rose-500/40 bg-rose-950/50 text-rose-300',
  brass: 'border-brass-500/40 bg-brass-950/50 text-brass-300',
  blue: 'border-blue-500/40 bg-blue-950/50 text-blue-300'
};
---

<div class={`rounded-2xl border p-4 sm:p-5 transition-all shadow-xl bg-[#0d1015] ${themeBorderStyles[theme]}`}>
  <!-- Header Info -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-lg">🎬</span>
      <span class={`text-[11px] font-mono font-bold uppercase px-2.5 py-0.5 rounded-full border ${badgeStyles[theme]}`}>
        {badge}
      </span>
      <h4 class="text-sm sm:text-base font-bold text-white font-sans">
        {title}
      </h4>
    </div>
    <a
      href={`https://www.youtube.com/watch?v=${videoId}`}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[11px] font-mono text-gray-400 hover:text-white flex items-center gap-1 shrink-0 transition-colors"
      title="YouTube에서 직접 시청하기"
    >
      <span>YouTube에서 보기</span>
      <span class="text-xs">↗</span>
    </a>
  </div>

  {subtitle && (
    <p class="text-xs text-gray-400 font-body-serif mb-3 break-keep">
      {subtitle}
    </p>
  )}

  <!-- Responsive Video Frame -->
  <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-black/60 border border-gray-800 shadow-inner">
    <iframe
      class="absolute inset-0 w-full h-full"
      src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0&modestbranding=1`}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      loading="lazy"
      allowfullscreen
    ></iframe>
  </div>

  {description && (
    <div class="mt-3 pt-3 border-t border-gray-800/80 text-[11px] sm:text-xs text-gray-400 font-body-serif leading-relaxed break-keep">
      {description}
    </div>
  )}
</div>

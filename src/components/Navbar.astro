---
const navItems = [
  { name: '홈 (개요)', href: '/' },
  { name: '생애 연표', href: '/biography' },
  { name: '차분기관', href: '/difference-engine' },
  { name: '해석기관', href: '/analytical-engine' },
  { name: '에이다 러브레이스', href: '/ada-lovelace' },
  { name: '경제학 & 철학', href: '/economy-philosophy' },
  { name: '사료 도서관', href: '/sources' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#0f1115]/85 border-b border-[#252c38]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-brass-400 via-brass-600 to-brass-800 flex items-center justify-center text-iron-950 font-bold text-lg shadow-lg shadow-brass-500/10 group-hover:scale-105 transition-transform duration-200">
            ⚙️
          </div>
          <div>
            <div class="font-display font-bold tracking-wider text-base text-brass-300 group-hover:text-brass-200 transition-colors">
              CHARLES BABBAGE
            </div>
            <div class="text-[10px] text-gray-400 tracking-widest uppercase -mt-0.5">
              Digital Archive & Legacy
            </div>
          </div>
        </a>
      </div>

      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-md text-xs lg:text-sm font-medium transition-all duration-200 ${
                isActive
                  ? 'bg-brass-500/15 text-brass-300 border border-brass-500/30 shadow-sm'
                  : 'text-gray-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href="/sources"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-gradient-to-r from-brass-600 to-brass-500 text-iron-950 hover:from-brass-500 hover:to-brass-400 shadow-md shadow-brass-500/20 transition-all hover:scale-[1.02]"
        >
          <span>📜 원문 사료 PDF</span>
        </a>
      </div>
    </div>
  </div>
</header>

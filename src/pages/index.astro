---
import Layout from '../layouts/Layout.astro';
import EngineSimulator from '../components/EngineSimulator';
import BernoulliTrace from '../components/BernoulliTrace';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="찰스 배비지 아카이브 - 컴퓨터 과학의 기원과 삶">
  {/* Hero Section */}
  <section class="relative pt-16 sm:pt-20 pb-20 sm:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
    <div class="text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brass-500/30 bg-brass-950/40 text-brass-300 text-xs font-mono mb-6 sm:mb-8 backdrop-blur shadow-sm">
        <span class="w-2 h-2 rounded-full bg-brass-400 animate-pulse"></span>
        1791–1871 • 빅토리아조 컴퓨터 과학의 창시자
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold text-white tracking-tight leading-[1.15] sm:leading-[1.1] mb-6 break-keep">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brass-200 via-brass-400 to-amber-500">
          찰스 배비지
        </span>
        <br />
        기계식 컴퓨터의 새벽
      </h1>

      <p class="text-sm sm:text-lg md:text-xl text-gray-300 font-body-serif font-light leading-relaxed max-w-3xl mx-auto mb-8 sm:mb-10 break-keep">
        "인간 계산원의 오류를 증기 기계의 톱니바퀴로 정복하겠다."<br class="hidden sm:inline" />
        차분기관(Difference Engine)에서 튜링 완전 범용 컴퓨터 해석기관(Analytical Engine)까지,<br class="hidden sm:inline" />
        19세기 1차 사료와 현대 컴퓨터 구조학의 시선으로 찰스 배비지의 위대한 유산을 탐구합니다.
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3 sm:gap-4 text-xs sm:text-sm font-semibold max-w-md sm:max-w-none mx-auto">
        <a
          href={`${base}/difference-engine`}
          class="px-5 py-3 sm:px-6 sm:py-3.5 rounded-lg bg-gradient-to-r from-brass-600 to-brass-500 hover:from-brass-500 hover:to-brass-400 text-iron-950 shadow-lg shadow-brass-500/20 transition-all transform hover:-translate-y-0.5 text-center"
        >
          ⚙️ 차분기관 시뮬레이터 체험
        </a>
        <a
          href={`${base}/ada-lovelace`}
          class="px-5 py-3 sm:px-6 sm:py-3.5 rounded-lg bg-[#1a202c] hover:bg-[#252e3d] text-gray-200 border border-gray-700/80 transition-all transform hover:-translate-y-0.5 text-center"
        >
          📜 에이다 러브레이스의 최초 프로그램
        </a>
        <a
          href={`${base}/sources`}
          class="px-5 py-3 sm:px-6 sm:py-3.5 rounded-lg bg-brass-950/40 hover:bg-brass-900/50 text-brass-300 border border-brass-500/40 transition-all transform hover:-translate-y-0.5 text-center"
        >
          📚 1차 사료 원문 PDF 도서관
        </a>
      </div>
    </div>
  </section>

  {/* 5 Thematic Pillars Section */}
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gray-800/80">
    <div class="text-center mb-10 sm:mb-14">
      <h2 class="text-xs font-mono uppercase text-brass-400 tracking-widest mb-2">THEMATIC PILLARS</h2>
      <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-white break-keep">5대 핵심 탐구 기둥</h3>
      <p class="text-xs sm:text-sm text-gray-400 mt-2 max-w-2xl mx-auto break-keep">
        배비지의 삶은 단순한 발명가를 넘어 수학자, 경제학자, 사회비판가, 그리고 미래학자였습니다.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {/* Card 1: Math & Early Life */}
      <a href={`${base}/biography`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-blue-950/50 border border-blue-500/30 text-blue-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            📐
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            1. 수학 & 해석학회 (1812)
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            케임브리지 대학 시절 뉴턴의 유율법에 갇힌 영국 수학계를 구하기 위해 존 허셜과 '해석학회'를 결성, 라이프니츠의 미분 표기법을 도입하고 루카스 석좌교수에 올랐습니다.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          생애 및 초기 학술 자세히 보기 →
        </span>
      </a>

      {/* Card 2: Difference Engine */}
      <a href={`${base}/difference-engine`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-amber-950/50 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            ⚙️
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            2. 차분기관 (Difference Engine)
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            유한차분법(Method of Differences)으로 덧셈만으로 수표를 자동 계산 및 조판 인쇄하는 기계. 1991년 런던 과학박물관이 실물 2호를 완성하여 19세기 설계의 완전성을 입증했습니다.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          유한차분법 & 시뮬레이터 →
        </span>
      </a>

      {/* Card 3: Analytical Engine */}
      <a href={`${base}/analytical-engine`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-purple-950/50 border border-purple-500/30 text-purple-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            🏛️
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            3. 해석기관 (Analytical Engine)
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            밀(Mill, ALU)과 스토어(Store, RAM)의 분리, 자카드 천공카드를 통한 조건 분기와 루프 제어를 구현한 역사상 최초의 범용 튜링 완전 기계식 컴퓨터 아키텍처.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          현대 컴퓨터 구조 대조 분석 →
        </span>
      </a>

      {/* Card 4: Ada Lovelace */}
      <a href={`${base}/ada-lovelace`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-pink-950/50 border border-pink-500/30 text-pink-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            📜
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            4. 에이다 러브레이스 & 최초의 프로그램
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            1843년 메나브레아 논문 번역과 7개의 주석(Notes A~G). 베르누이 수 계산 알고리즘을 천공카드 실행표로 설계하여 세계 최초의 컴퓨터 프로그래머로 기록되었습니다.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          Note G 알고리즘 코드 분석 →
        </span>
      </a>

      {/* Card 5: Economy & Philosophy */}
      <a href={`${base}/economy-philosophy`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-emerald-950/50 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            🏭
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            5. 산업경제학 & 사회철학
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            『기계 및 제조업의 경제학』(1832)의 배비지 원칙(분업 최적화), 『제9 브리지워터 논문』의 기적과 기계 자연법칙론, 균일 우편요금제 및 철도 배장기 발명.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          경제학 및 철학 저작 해제 →
        </span>
      </a>

      {/* Card 6: Primary Sources */}
      <a href={`${base}/sources`} class="group bg-[#12161f] border border-gray-800 hover:border-brass-500/50 rounded-xl p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brass-500/5 flex flex-col justify-between">
        <div>
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg bg-brass-950/50 border border-brass-500/30 text-brass-400 flex items-center justify-center text-xl sm:text-2xl mb-4 group-hover:scale-110 transition-transform">
            📚
          </div>
          <h4 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-brass-300 transition-colors mb-2 break-keep">
            6. 1차 사료 원본 도서관
          </h4>
          <p class="text-xs text-gray-400 leading-relaxed mb-4 font-body-serif break-keep">
            인터넷 아카이브, 영국 왕립학회, 과학박물관 등에서 수집한 19세기 원문 논문, 자서전, 도면 PDF 및 한글 대조 번역 데이터베이스.
          </p>
        </div>
        <span class="text-xs font-mono text-brass-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
          원문 아카이브 탐색하기 →
        </span>
      </a>
    </div>
  </section>

  {/* Interactive Simulators Preview */}
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gray-800/80">
    <div class="mb-6 sm:mb-8">
      <h2 class="text-xs font-mono uppercase text-brass-400 tracking-widest mb-1">INTERACTIVE SIMULATION</h2>
      <h3 class="text-xl sm:text-2xl lg:text-3xl font-display font-bold text-white break-keep">
        톱니바퀴의 연산: 차분기관 시뮬레이터
      </h3>
    </div>
    
    <div class="overflow-x-auto">
      <EngineSimulator client:load />
    </div>
  </section>

  {/* Lovelace Algorithm Preview */}
  <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-gray-800/80">
    <div class="mb-6 sm:mb-8">
      <h2 class="text-xs font-mono uppercase text-purple-400 tracking-widest mb-1">THE FIRST COMPUTER PROGRAM</h2>
      <h3 class="text-xl sm:text-2xl lg:text-3xl font-display font-bold text-white break-keep">
        에이다 러브레이스의 1843년 Note G 알고리즘
      </h3>
    </div>
    
    <div class="overflow-x-auto">
      <BernoulliTrace client:load />
    </div>
  </section>

  {/* Famous Quotes Banner */}
  <section class="py-14 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-center border-t border-gray-800/80">
    <blockquote class="text-lg sm:text-xl lg:text-2xl font-serif italic text-brass-200 leading-relaxed mb-6 break-keep">
      "The Analytical Engine weaves algebraical patterns just as the Jacquard-loom weaves flowers and leaves."
    </blockquote>
    <div class="text-xs sm:text-sm text-gray-400 font-sans break-keep">
      — <span class="text-white font-semibold">Ada Lovelace (에이다 러브레이스)</span>, 1843년 『해석기관에 관한 주석 (Note A)』
    </div>
  </section>
</Layout>
